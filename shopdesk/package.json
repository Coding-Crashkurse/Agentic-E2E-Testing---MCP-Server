{
  "name": "shopdesk",
  "private": true,
  "version": "0.1.0",
  "description": "ShopDesk – Mini-Warenkorb-Demo mit absichtlich eingebauten Bugs (per ?bug=… wählbar) für End-to-End-Testagenten.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/shopdesk.mjs dev",
    "build": "tsc -b && node scripts/shopdesk.mjs build",
    "preview": "node scripts/shopdesk.mjs preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "images:placeholders": "uv run scripts/generate_placeholders.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "lucide-react": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
